# Fire Detection Platform - Environment Variables Example
# Copy this file to .env and fill in your values

# REQUIRED: JWT Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage Limits (in bytes)
MAX_STORAGE_BYTES=1073741824
MAX_FILE_SIZE_BYTES=1073741824
MAX_UPLOAD_SIZE_MB=1024

# Concurrency
MAX_CONCURRENT_TASKS=1

# Video Stream
STREAM_FPS=30
RECONNECT_MAX_RETRIES=3

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CORS_MAX_AGE=600

# Broker Configuration (Optional, defaults to InMemory)
# REDIS_URL=redis://localhost:6379/0

# ==========================================
# Media Configuration
# ==========================================

# FFmpeg video capture switch: "True" enables FFmpegCapture, "False" uses OpenCV
USE_FFMPEG_CAPTURE=True

# MediaMTX configuration
# MEDIAMTX_API_PORT=9997
# MEDIAMTX_RTSP_PORT=8554
# MEDIAMTX_HLS_PORT=8888
# MEDIAMTX_API_URL=http://127.0.0.1:9997
# MEDIAMTX_RTSP_BASE=rtsp://127.0.0.1:8554/
# MEDIAMTX_HLS_URL=http://127.0.0.1:8888/
