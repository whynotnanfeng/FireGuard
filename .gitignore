# ──────────────────────────────────────────────────────────────────────────────
# FireGuard Project Git Ignore Configuration
# ──────────────────────────────────────────────────────────────────────────────

# --- System & OS ---
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak
.directory

# --- AI Agent & Developer Tools (MANDATORY IGNORE) ---
.agents/
.gemini/
.claude/
.agent/
.antigravity/
.trae/
.kiro/
brain/
scratch/
plan_act_agent*/
CLAUDE.md
skills/
skills-lock.json
*.session
.cursor/
.windsurf/

# --- Frontend (Vue/Vite) ---
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.env.local
frontend/.env.*.local
frontend/.eslintcache
frontend/.stylelintcache

# --- Backend & Python ---
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.pytest_cache/
**/.venv/
**/venv/
**/env/
**/ENV/
**/build/
**/dist/
**/*.egg-info/

# --- Project Data & Databases (Ignore all local state) ---
data/
backend/data/*
!backend/data/.gitkeep
backend/logs/*
!backend/logs/.gitkeep
backend/scratch/
backend/*.db
*.db
*.sqlite3

# --- Simulator Binaries & Data ---
simulator/bin/
simulator/data/*
!simulator/data/.gitkeep
simulator/uploads/
testdata/

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo
.history/
